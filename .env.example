# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq AI pipeline
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# App URL
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Debug endpoint (optional)
# Set to enable /api/debug in production. Use a strong random string.
# DEBUG_SECRET=your_strong_random_secret_here

# Development-only rate-limit bypass (optional)
# Ignored when NODE_ENV=production.
# DEV_BYPASS_RATE_LIMIT=true

# Removed integrations
# APIFY_TOKEN: removed, replaced by google-play-scraper
# APIFY_WEBHOOK_SECRET: removed
# APIFY_ACTOR_PLAY_STORE: removed
